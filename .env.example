# Copy to `.env` and fill in. Required before `npm run dev` can serve data.

# --- Database (required) ---------------------------------------------------
# Runtime connection. For Supabase use the transaction pooler on port 6543:
#   postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require
# Any PostgreSQL connection string. Local example:
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/educonnect?schema=public"
# Hosted (Neon / Supabase / Railway) connection strings work as-is.
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

# Prisma CLI connection. For Supabase use the session pooler on port 5432
# when the direct db.PROJECT_REF.supabase.co host is unreachable over IPv6.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require"

# --- Auth (required) -------------------------------------------------------
# Signs the session JWT. Use a long random string in production.
JWT_SECRET="change-me-to-a-long-random-string"

# --- First administrator (required for the one-time seed) ------------------
ADMIN_NAME="System Admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-long-random-password"

# --- LiveKit (optional) ----------------------------------------------------
# Without these the /api/live/token route returns a mock token so the live
# room UI still renders — video just won't connect.
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
NEXT_PUBLIC_LIVEKIT_URL="wss://your-project.livekit.cloud"
