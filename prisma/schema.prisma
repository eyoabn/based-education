generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum TeacherStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  NEW_POST
  LIVE_CLASS_STARTING
  CLASS_SCHEDULED
  ASSIGNMENT_DUE
  GRADE_RELEASED
  ACCOUNT_APPROVED
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  passwordHash  String
  role          Role           @default(STUDENT)
  teacherStatus TeacherStatus?
  avatarUrl     String?
  bio           String?

  posts         Post[]
  comments      Comment[]
  notifications Notification[]
  liveRooms     LiveRoom[]
  attendances   Attendance[]
  submissions   Submission[]

  // Phase 4: course membership drives "enrolled vs attended" and schedule fan-out
  taughtCourses Course[]       @relation("CourseTeacher")
  enrolledIn    Course[]       @relation("CourseEnrollment")
  assignments   Assignment[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Post {
  id        String   @id @default(uuid())
  authorId  String
  content   String
  mediaUrls String[]
  createdAt DateTime @default(now())

  author    User      @relation(fields: [authorId], references: [id])
  comments  Comment[]
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  post      Post     @relation(fields: [postId], references: [id])
  author    User     @relation(fields: [authorId], references: [id])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
}

/// Phase 4: a Course groups enrolled students so scheduled classes,
/// assignments and exams can be targeted at a cohort.
model Course {
  id          String       @id @default(uuid())
  title       String
  code        String       @unique
  description String?
  teacherId   String

  teacher     User         @relation("CourseTeacher", fields: [teacherId], references: [id])
  students    User[]       @relation("CourseEnrollment")
  liveRooms   LiveRoom[]
  assignments Assignment[]
  exams       Exam[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model LiveRoom {
  id          String       @id @default(uuid())
  title       String
  teacherId   String
  isLive      Boolean      @default(false)
  scheduledAt DateTime

  // Phase 4: scheduling metadata
  description String?
  endsAt      DateTime?
  courseId    String?
  startedAt   DateTime?
  endedAt     DateTime?

  teacher     User         @relation(fields: [teacherId], references: [id])
  course      Course?      @relation(fields: [courseId], references: [id])
  attendances Attendance[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([teacherId, scheduledAt])
  @@index([courseId, scheduledAt])
}

model Attendance {
  id          String    @id @default(uuid())
  roomId      String
  studentId   String
  joinedAt    DateTime  @default(now())
  leftAt      DateTime?
  durationSec Int       @default(0)

  // Phase 4: heartbeat presence tracking.
  // activeSec counts only the seconds where the tab was visible/focused,
  // so activeSec / durationSec yields an "attention %".
  activeSec   Int       @default(0)
  lastPingAt  DateTime?
  isActive    Boolean   @default(true)

  room        LiveRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  student     User      @relation(fields: [studentId], references: [id])

  // One attendance row per student per room; pings upsert against this.
  @@unique([roomId, studentId])
  @@index([roomId])
}

/// Phase 4: assignment deadlines surface on the student calendar.
model Assignment {
  id          String   @id @default(uuid())
  title       String
  description String?
  courseId    String?
  teacherId   String
  dueAt       DateTime

  course      Course?  @relation(fields: [courseId], references: [id])
  teacher     User     @relation(fields: [teacherId], references: [id])

  createdAt   DateTime @default(now())

  @@index([courseId, dueAt])
}

model Exam {
  id           String       @id @default(uuid())
  title        String
  durationMins Int
  questions    Json

  // Phase 4: due dates so exams appear on the student calendar
  dueAt        DateTime?
  courseId     String?
  course       Course?      @relation(fields: [courseId], references: [id])

  submissions  Submission[]

  @@index([courseId, dueAt])
}

model Submission {
  id          String  @id @default(uuid())
  examId      String
  studentId   String
  score       Float?
  feedback    String?
  tabSwitches Int     @default(0)

  exam        Exam    @relation(fields: [examId], references: [id])
  student     User    @relation(fields: [studentId], references: [id])
}
