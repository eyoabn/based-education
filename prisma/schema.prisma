generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum TeacherStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  NEW_POST
  LIVE_CLASS_STARTING
  CLASS_SCHEDULED
  ASSIGNMENT_DUE
  GRADE_RELEASED
  ACCOUNT_APPROVED
  // Phase 5
  EXAM_PUBLISHED
  EXAM_SUBMITTED
  // Phase 6 — governance notices raised by the admin portal
  ACCOUNT_REJECTED
  ACCOUNT_SUSPENDED
  ACCOUNT_REINSTATED
  ROLE_CHANGED
  PLATFORM_BROADCAST
}

/// Phase 5: an assessment is either a timed, locked-down exam or an
/// untimed assignment. The distinction only changes how the student
/// portal presents it — grading is identical.
enum AssessmentType {
  EXAM
  ASSIGNMENT
}

/// Phase 5: a submission's lifecycle. Auto-grading runs on submit, so a
/// paper with no essay questions goes straight from SUBMITTED to GRADED
/// once the teacher releases it.
enum SubmissionStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

/// Phase 6: every privileged mutation an admin performs lands in `AuditLog`
/// under one of these verbs, so the monetization page can render an
/// accountable history of who did what to whom.
enum AuditAction {
  TEACHER_APPROVED
  TEACHER_REJECTED
  USER_BANNED
  USER_REINSTATED
  USER_ROLE_CHANGED
  PASSWORD_RESET_ISSUED
  BROADCAST_SENT
  MAINTENANCE_TOGGLED
  PLAN_UPDATED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  passwordHash  String
  role          Role           @default(STUDENT)
  teacherStatus TeacherStatus?
  avatarUrl     String?
  bio           String?

  // --- Phase 6: teacher verification dossier ---
  /// Free-text subject the applicant teaches — shown on the approval card.
  specialty       String?
  /// `CredentialDoc[]` — see `lib/admin.ts`. Résumés and certificates the
  /// applicant uploaded, previewed in the credential viewer.
  credentials     Json      @default("[]")
  /// Why the application was rejected. Sent to the teacher verbatim.
  rejectionReason String?
  reviewedAt      DateTime?
  reviewedById    String?

  // --- Phase 6: governance ---
  isBanned             Boolean   @default(false)
  banReason            String?
  bannedAt             DateTime?
  /// Bumped on ban, role change or forced logout. A JWT carries the epoch it
  /// was minted with, so a stale token fails `requireSession()` on its very
  /// next request — that is how a ban revokes live sessions without the
  /// server holding session state.
  sessionEpoch         Int       @default(0)
  lastLoginAt          DateTime?
  /// Single-use link the admin generates for a locked-out user.
  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?

  posts         Post[]
  comments      Comment[]
  notifications Notification[]
  liveRooms     LiveRoom[]
  attendances   Attendance[]
  submissions   Submission[]

  // Phase 4: course membership drives "enrolled vs attended" and schedule fan-out
  taughtCourses Course[]     @relation("CourseTeacher")
  enrolledIn    Course[]     @relation("CourseEnrollment")
  assignments   Assignment[]

  // Phase 5: exams and assignments this teacher authored
  authoredExams Exam[] @relation("ExamAuthor")

  // Phase 6: admin trail — actions this admin took, and actions taken on them
  actionsTaken     AuditLog[] @relation("AuditActor")
  actionsReceived  AuditLog[] @relation("AuditTarget")
  payments         Payment[]
  /// The admin who last ruled on this teacher's application.
  reviewedBy       User?      @relation("TeacherReview", fields: [reviewedById], references: [id])
  reviewedTeachers User[]     @relation("TeacherReview")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The approval queue reads by role + status; the governance table filters
  // on the same pair plus the ban flag.
  @@index([role, teacherStatus])
  @@index([isBanned])
  @@index([createdAt])
}

model Post {
  id        String   @id @default(uuid())
  authorId  String
  content   String
  mediaUrls String[]
  createdAt DateTime @default(now())

  author   User      @relation(fields: [authorId], references: [id])
  comments Comment[]
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  post   Post @relation(fields: [postId], references: [id])
  author User @relation(fields: [authorId], references: [id])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
}

/// Phase 4: a Course groups enrolled students so scheduled classes,
/// assignments and exams can be targeted at a cohort.
model Course {
  id          String  @id @default(uuid())
  title       String
  code        String  @unique
  description String?
  teacherId   String

  teacher     User         @relation("CourseTeacher", fields: [teacherId], references: [id])
  students    User[]       @relation("CourseEnrollment")
  liveRooms   LiveRoom[]
  assignments Assignment[]
  exams       Exam[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LiveRoom {
  id          String   @id @default(uuid())
  title       String
  teacherId   String
  isLive      Boolean  @default(false)
  scheduledAt DateTime

  // Phase 4: scheduling metadata
  description String?
  endsAt      DateTime?
  courseId    String?
  startedAt   DateTime?
  endedAt     DateTime?

  teacher     User         @relation(fields: [teacherId], references: [id])
  course      Course?      @relation(fields: [courseId], references: [id])
  attendances Attendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId, scheduledAt])
  @@index([courseId, scheduledAt])
}

model Attendance {
  id          String    @id @default(uuid())
  roomId      String
  studentId   String
  joinedAt    DateTime  @default(now())
  leftAt      DateTime?
  durationSec Int       @default(0)

  // Phase 4: heartbeat presence tracking.
  // activeSec counts only the seconds where the tab was visible/focused,
  // so activeSec / durationSec yields an "attention %".
  activeSec  Int       @default(0)
  lastPingAt DateTime?
  isActive   Boolean   @default(true)

  room    LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  student User     @relation(fields: [studentId], references: [id])

  // One attendance row per student per room; pings upsert against this.
  @@unique([roomId, studentId])
  @@index([roomId])
}

/// Phase 4: assignment deadlines surface on the student calendar.
model Assignment {
  id          String   @id @default(uuid())
  title       String
  description String?
  courseId    String?
  teacherId   String
  dueAt       DateTime

  course  Course? @relation(fields: [courseId], references: [id])
  teacher User    @relation(fields: [teacherId], references: [id])

  createdAt DateTime @default(now())

  @@index([courseId, dueAt])
}

model Exam {
  id           String @id @default(uuid())
  title        String
  durationMins Int
  /// `ExamQuestion[]` — see `lib/exams.ts`. Holds the answer key, so this
  /// column is never sent to a student unsanitised.
  questions    Json

  // Phase 4: due dates so exams appear on the student calendar
  dueAt    DateTime?
  courseId String?
  course   Course?   @relation(fields: [courseId], references: [id])

  // --- Phase 5: authoring ---
  description String?
  type        AssessmentType @default(EXAM)
  /// Sum of every question's points, denormalised so the gradebook can
  /// show "18 / 25" without re-reading the question JSON.
  totalPoints Float          @default(0)
  passingPct  Int            @default(50)
  isPublished Boolean        @default(false)
  teacherId   String?
  teacher     User?          @relation("ExamAuthor", fields: [teacherId], references: [id])

  // --- Phase 5: anti-cheat configuration ---
  forceFullscreen  Boolean @default(true)
  trackTabSwitches Boolean @default(true)
  /// Switches allowed before the submission is flagged for the teacher.
  maxTabSwitches   Int     @default(3)
  blockCopyPaste   Boolean @default(true)
  randomizeOrder   Boolean @default(true)

  submissions Submission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([courseId, dueAt])
  @@index([teacherId, createdAt])
}

model Submission {
  id          String  @id @default(uuid())
  examId      String
  studentId   String
  /// Released score = auto-graded points + teacher-awarded essay points.
  /// Null until the teacher releases the grade.
  score       Float?
  feedback    String?
  tabSwitches Int     @default(0)

  // --- Phase 5 ---
  /// `StudentAnswer[]` — one entry per question, carrying the student's
  /// response and the points it earned.
  answers     Json             @default("[]")
  /// Points the engine awarded without human review (MCQ + True/False).
  autoScore   Float            @default(0)
  /// Snapshot of the paper's total at submit time, so later edits to the
  /// exam don't retroactively change an already-graded score.
  maxScore    Float            @default(0)
  status      SubmissionStatus @default(IN_PROGRESS)
  /// Server-authoritative clock start — the timer the student sees is a
  /// convenience, this is what the deadline is checked against.
  startedAt   DateTime         @default(now())
  submittedAt DateTime?
  gradedAt    DateTime?
  /// True when tabSwitches exceeded the exam's limit, or the paper landed
  /// after the server-side deadline.
  isFlagged   Boolean          @default(false)
  /// `ViolationEvent[]` — timestamped anti-cheat log for the teacher.
  violations  Json             @default("[]")

  exam    Exam @relation(fields: [examId], references: [id], onDelete: Cascade)
  student User @relation(fields: [studentId], references: [id])

  // One attempt per student per exam; starting an exam upserts against this.
  @@unique([examId, studentId])
  @@index([examId, status])
  @@index([studentId])
}

// ---------------------------------------------------------------------------
// Phase 6 — platform operations
// ---------------------------------------------------------------------------

/// An append-only record of every privileged action. Nothing here is ever
/// updated or deleted: the value of the log is that it cannot be tidied up.
model AuditLog {
  id           String      @id @default(uuid())
  action       AuditAction
  adminId      String
  targetUserId String?
  /// Human-readable one-liner, rendered straight into the audit table.
  summary      String
  /// Free-form context — rejection reason, previous role, recipient count.
  metadata     Json        @default("{}")
  createdAt    DateTime    @default(now())

  admin  User  @relation("AuditActor", fields: [adminId], references: [id])
  target User? @relation("AuditTarget", fields: [targetUserId], references: [id])

  @@index([createdAt])
  @@index([adminId, createdAt])
  @@index([targetUserId, createdAt])
}

/// Single-row platform configuration, always read through
/// `getPlatformSettings()` in `lib/adminAuth.ts`, which upserts the row on
/// first read so a fresh database still boots.
model PlatformSetting {
  id               String   @id @default("platform")
  maintenanceMode  Boolean  @default(false)
  /// Shown to non-admins while maintenance mode is on.
  maintenanceNote  String?
  /// Percentage of each teacher charge the platform keeps.
  commissionPct    Int      @default(15)
  registrationOpen Boolean  @default(true)
  updatedById      String?
  updatedAt        DateTime @updatedAt
}

/// A purchasable tier. Prices are held in minor units (cents) so no float
/// ever touches money.
model SubscriptionPlan {
  id         String          @id @default(uuid())
  name       String
  slug       String          @unique
  /// Who the plan is sold to — teacher tiers vs. student access fees.
  audience   Role            @default(TEACHER)
  priceCents Int
  interval   BillingInterval @default(MONTHLY)
  /// `string[]` — the bullet list shown on the plan card.
  features   Json            @default("[]")
  isActive   Boolean         @default(true)
  sortOrder  Int             @default(0)

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([audience, sortOrder])
}

/// One charge. `commissionCents` is snapshotted at charge time so a later
/// change to `PlatformSetting.commissionPct` never rewrites history.
model Payment {
  id              String        @id @default(uuid())
  userId          String
  planId          String?
  amountCents     Int
  commissionCents Int           @default(0)
  status          PaymentStatus @default(PAID)
  description     String?
  createdAt       DateTime      @default(now())

  user User              @relation(fields: [userId], references: [id])
  plan SubscriptionPlan? @relation(fields: [planId], references: [id])

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([userId, createdAt])
}
