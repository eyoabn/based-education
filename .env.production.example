# =============================================================================
# EDUCONNECT — PRODUCTION ENVIRONMENT TEMPLATE
# =============================================================================
# Copy this file to `.env` (or set these as secrets in Vercel / Railway)
# and fill in every value before deploying.
#
# Never put real values in this example. Copy it to `.env`, which is ignored.
# =============================================================================

# -----------------------------------------------------------------------------
# 🗄  DATABASE  (PostgreSQL)
# -----------------------------------------------------------------------------
# Primary connection — used by Prisma Client at runtime.
# Supabase transaction pooler:
#   postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require
# Neon:      postgresql://[user]:[password]@ep-[name].us-east-2.aws.neon.tech/neondb?sslmode=require
# Railway:   auto-filled in Railway dashboard; copy the "Postgres URL" variable.
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

# Prisma CLI URL used by `prisma migrate deploy`, `prisma migrate dev`, and
# `prisma db push`. Prefer the Supabase session pooler on port 5432 when the
# direct db.[ref].supabase.co endpoint is blocked or resolves to IPv6 only.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require"

# -----------------------------------------------------------------------------
# 🔐  AUTH / JWT
# -----------------------------------------------------------------------------
# Generate a 64-character random secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   openssl rand -hex 32
JWT_SECRET="REPLACE_WITH_64_HEX_CHARS_GENERATED_BY_OPENSSL_RAND_HEX_32"

ADMIN_NAME="System Admin"
ADMIN_EMAIL="admin@your-domain.com"
ADMIN_PASSWORD="REPLACE_WITH_A_LONG_RANDOM_PASSWORD"

# ----------------------------------------------------------------------------- 
# 🌍  APP
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="https://educonnect.com"

# The Next.js production server address (used for internal API calls in SSR).
# On Railway/Render this is the same as APP_URL; on Vercel use VERCEL_URL.
NEXTAUTH_URL="https://educonnect.com"

# -----------------------------------------------------------------------------
# 🎥  LIVEKIT  WebRTC
# -----------------------------------------------------------------------------
# Option A — LiveKit Cloud (recommended, zero-ops):
#   Create a project at https://cloud.livekit.io and copy the keys.
#
# Option B — Self-hosted on VPS (see docker-compose.livekit.yml):
#   LIVEKIT_API_KEY and LIVEKIT_API_SECRET come from your livekit.yaml file.
#   NEXT_PUBLIC_LIVEKIT_URL is the WSS address served by Caddy (see Caddyfile).
LIVEKIT_API_KEY="APIxxxxxxxxxxxxxxxxx"
LIVEKIT_API_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_LIVEKIT_URL="wss://live.educonnect.com"

# -----------------------------------------------------------------------------
# 🪣  OBJECT STORAGE  (AWS S3 or Cloudflare R2)
# -----------------------------------------------------------------------------
# Used for: avatar uploads, PDF assignments, recorded sessions.
#
# Cloudflare R2 (recommended — no egress fees):
#   S3_ENDPOINT="https://[account-id].r2.cloudflarestorage.com"
#   S3_REGION="auto"
#
# AWS S3:
#   S3_ENDPOINT=""   # leave empty — SDK defaults to AWS
#   S3_REGION="us-east-1"
S3_BUCKET_NAME="educonnect-uploads"
S3_REGION="auto"
S3_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
S3_ACCESS_KEY="REPLACE_WITH_ACCESS_KEY"
S3_SECRET_KEY="REPLACE_WITH_SECRET_KEY"
# Public CDN base URL — returned to clients to render uploaded assets.
NEXT_PUBLIC_STORAGE_URL="https://cdn.educonnect.com"

# -----------------------------------------------------------------------------
# 📧  EMAIL  (optional — for password-reset and approval notifications)
# -----------------------------------------------------------------------------
# Resend (recommended):  https://resend.com/api-keys
# SMTP also works — swap RESEND_API_KEY for the variables below.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="no-reply@educonnect.com"

# SMTP alternative
# SMTP_HOST="smtp.sendgrid.net"
# SMTP_PORT="587"
# SMTP_USER="apikey"
# SMTP_PASS="SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# -----------------------------------------------------------------------------
# 💳  PAYMENTS  (Stripe — optional for Phase 6 monetisation)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# -----------------------------------------------------------------------------
# 🔭  OBSERVABILITY  (optional but recommended)
# -----------------------------------------------------------------------------
# Sentry — error tracking
NEXT_PUBLIC_SENTRY_DSN="https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@o000000.ingest.sentry.io/0000000"
SENTRY_AUTH_TOKEN="sntrys_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
SENTRY_ORG="your-org"
SENTRY_PROJECT="educonnect"

# Axiom / Logtail / Grafana Loki — structured server logs
AXIOM_DATASET="educonnect-prod"
AXIOM_TOKEN="xaat-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
